diff --git a/ruyi/mux/runtime.py b/ruyi/mux/runtime.py
index c65f53f..7012fc7 100644
--- a/ruyi/mux/runtime.py
+++ b/ruyi/mux/runtime.py
@@ -18,9 +18,57 @@ def _run_exit_handlers_and_execv(
     # crucially this includes our telemetry handler so we don't lose telemetry
     # events in mux mode
     atexit._run_exitfuncs()
+
+    # On NixOS, pre-compiled binaries (cross-toolchains, QEMU, etc.) may
+    # have a dynamic linker path that doesn't exist.  Transparently re-wrap
+    # through the NixOS ld.so when needed.
+    # Save the original binary path — wrap_exec_for_nixos may change
+    # `path` to the ld.so itself, and we need the original when fixing
+    # the toolchain sub-binaries below.
+    _orig_path = path
+    try:
+        from ..utils.nixos_compat import (
+            wrap_exec_for_nixos,
+            ensure_toolchain_nixos_compat,
+        )
+        path, argv = wrap_exec_for_nixos(path, argv)
+
+        # If we are about to launch a toolchain binary (e.g. a cross-GCC),
+        # also ensure that the *internal* binaries (cc1, as, collect2 …)
+        # have been patchelf-ed.  Those sub-processes are launched directly
+        # by GCC and skip the ruyi mux.
+        _maybe_fix_toolchain_sub_binaries(_orig_path)
+    except Exception as _exc:
+        # Log but don't block — the binary may still work with ld.so wrapper
+        import sys as _sys
+        print(
+            f"[ruyi] nixos toolchain repair skipped: {_exc}",
+            file=_sys.stderr,
+        )
+
     os.execv(path, argv)
 
 
+def _maybe_fix_toolchain_sub_binaries(binpath: str) -> None:
+    """If *binpath* lives inside a Ruyi-managed toolchain, repair the
+    ELF interpreter of all sub-binaries in that toolchain so GCC
+    sub-processes work on NixOS."""
+    import os as _os
+
+    _ruyi_binaries_dir = _os.path.expanduser("~/.local/share/ruyi/binaries")
+    if not binpath.startswith(_ruyi_binaries_dir):
+        return
+
+    # binpath is e.g. …/gnu-upstream-0.20260201.0/bin/riscv64-…-gcc
+    # The toolchain root is two levels up (above bin/) — the whole
+    # extracted tarball.
+    _toolchain_root = _os.path.dirname(_os.path.dirname(binpath))
+    if not _os.path.isdir(_toolchain_root):
+        return
+
+    ensure_toolchain_nixos_compat(_toolchain_root)
+
+
 def mux_main(
     gm: ProvidesGlobalMode,
     gc: GlobalConfig,
