diff -ruN a/rog-control-center/src/ui/setup_aura.rs b/rog-control-center/src/ui/setup_aura.rs
--- a/rog-control-center/src/ui/setup_aura.rs	2026-06-02 06:32:08.543045615 +0900
+++ b/rog-control-center/src/ui/setup_aura.rs	2026-06-02 06:37:03.886011532 +0900
@@ -1,6 +1,6 @@
 use std::sync::{Arc, Mutex};
 
-use log::{debug, error, info};
+use log::{debug, error, info, warn};
 use rog_aura::keyboard::LaptopAuraPower;
 use rog_aura::{AuraDeviceType, PowerZones};
 use rog_dbus::zbus_aura::AuraProxy;
@@ -75,7 +75,10 @@
     let handle = ui.as_weak();
     tokio::spawn(async move {
         let Ok(aura) = find_aura_iface().await else {
-            info!("No aura interfaces");
+            info!("No aura interfaces — keyboard likely disconnected");
+            handle.upgrade_in_event_loop(move |h| {
+                h.global::<AuraPageData>().set_keyboard_connected(false);
+            }).ok();
             return Ok::<(), zbus::Error>(());
         };
 
@@ -126,13 +129,24 @@
             .map_err(|e| error!("{e}"))
             .ok();
 
+        let mut keyboard_connected = false;
         if let Ok(mut pow3r) = aura.supported_power_zones().await {
             let dev = aura
                 .device_type()
                 .await
                 .unwrap_or(AuraDeviceType::LaptopKeyboard2021);
+
+            keyboard_connected = dev != AuraDeviceType::Unknown;
+
             handle
                 .upgrade_in_event_loop(move |handle| {
+                    if !keyboard_connected {
+                        info!("Keyboard not detected. Aura controls disabled.");
+                        handle.global::<AuraPageData>().set_keyboard_connected(false);
+                        return;
+                    }
+                    handle.global::<AuraPageData>().set_keyboard_connected(true);
+
                     let names: Vec<SharedString> = handle
                         .global::<AuraPageData>()
                         .get_power_zone_names()
@@ -141,7 +141,17 @@
                     if dev.is_old_laptop() {
                         pow3r.retain(|z| *z != PowerZones::None);
-                        let n: Vec<SharedString> =
-                            pow3r.iter().map(|z| names[(*z) as usize].clone()).collect();
+                        let n: Vec<SharedString> = pow3r
+                            .iter()
+                            .filter_map(|z| {
+                                let idx = *z as i32;
+                                if idx >= 0 && (idx as usize) < names.len() {
+                                    Some(names[idx as usize].clone())
+                                } else {
+                                    warn!("Invalid PowerZone idx {}", idx);
+                                    None
+                                }
+                            })
+                            .collect();
                         handle
                             .global::<AuraPageData>()
                             .set_power_zone_names_old(n.as_slice().into());
@@ -235,6 +263,59 @@
             }
         });
         debug!("Aura setup done");
+
+        if !keyboard_connected {
+            // Listen for D-Bus InterfacesAdded to detect keyboard hotplug.
+            let hotplug_handle = handle.clone();
+            tokio::spawn(async move {
+                let conn = match zbus::Connection::system().await {
+                    Ok(c) => c,
+                    Err(e) => {
+                        warn!("Hotplug: cannot connect to system bus: {e}");
+                        return;
+                    }
+                };
+                let mgr = match zbus::fdo::ObjectManagerProxy::new(
+                    &conn, "xyz.ljones.Asusd", "/",
+                )
+                .await
+                {
+                    Ok(m) => m,
+                    Err(e) => {
+                        warn!("Hotplug: cannot create ObjectManager proxy: {e}");
+                        return;
+                    }
+                };
+                use futures_util::StreamExt;
+                let mut stream = match mgr.receive_interfaces_added().await {
+                    Ok(s) => s,
+                    Err(e) => {
+                        warn!("Hotplug: cannot listen for interfaces: {e}");
+                        return;
+                    }
+                };
+                while let Some(signal) = stream.next().await {
+                    let Ok(args) = signal.args() else { continue };
+                    // Check if any newly-added interface is an Aura device
+                    let has_aura = args
+                        .interfaces_and_properties
+                        .iter()
+                        .any(|(iface, _)| iface.as_str() == "xyz.ljones.Aura");
+                    if !has_aura {
+                        continue;
+                    }
+                    info!("Aura interface appeared — keyboard reconnected, restoring UI");
+                    hotplug_handle
+                        .upgrade_in_event_loop(move |h| {
+                            h.global::<AuraPageData>()
+                                .set_keyboard_connected(true);
+                        })
+                        .ok();
+                    break;
+                }
+            });
+        }
+
         Ok(())
     });
 }
