+                        let n: Vec<SharedString> = pow3r
+                            .iter()
+                            .filter_map(|z| {
+                                let idx = *z as i32;
+                                if idx >= 0 && (idx as usize) < names.len() {
+                                    Some(names[idx as usize].clone())
+                                } else {
+                                    warn!("Invalid PowerZone idx {}", idx);
+                                    None
+                                }
+                            })
+                            .collect();
                         handle
                             .global::<AuraPageData>()
                             .set_power_zone_names_old(n.as_slice().into());
                     } else {
-                        let p: Vec<SlintPowerZones> = pow3r.iter().map(|z| (*z).into()).collect();
+                        let p: Vec<SlintPowerZones> = pow3r
+                            .iter()
+                            .filter(|z| **z != PowerZones::None)
+                            .map(|z| (*z).into())
+                            .collect();
                         handle
                             .global::<AuraPageData>()
                             .set_supported_power_zones(p.as_slice().into());
@@ -235,6 +263,25 @@
             }
         });
         debug!("Aura setup done");
+
+        if !keyboard_connected {
+            let hotplug_handle = handle.clone();
+            let hotplug_aura = aura.clone();
+            tokio::spawn(async move {
+                loop {
+                    tokio::time::sleep(tokio::time::Duration::from_secs(5)).await;
+                    let Ok(dev) = hotplug_aura.device_type().await else { continue };
+                    if dev == AuraDeviceType::Unknown { continue }
+                    info!("Keyboard reconnected ({dev:?}), restoring Aura UI");
+                    hotplug_handle.upgrade_in_event_loop(move |h| {
+                        h.global::<AuraPageData>().set_device_type(dev.into());
+                        h.global::<AuraPageData>().set_keyboard_connected(true);
+                    }).ok();
+                    break;
+                }
+            });
+        }
+
         Ok(())
     });
 }
