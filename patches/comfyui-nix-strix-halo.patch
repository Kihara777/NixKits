diff --git a/nix/python-overrides.nix b/nix/python-overrides.nix
index 5e8dd30..af68fa2 100644
--- a/nix/python-overrides.nix
+++ b/nix/python-overrides.nix
@@ -19,7 +19,12 @@ let
 
   # Pre-built PyTorch ROCm wheels from pytorch.org
   # These avoid compiling PyTorch from source (which requires 30-60GB RAM and hours of build time)
-  rocmWheels = versions.pytorchWheels.rocm71;
+  rocmVersion =
+    if versions.pytorchWheels ? rocm72 && gpuSupport == "rocm" then "7.2"
+    else "7.1";
+  rocmWheels =
+    if rocmVersion == "7.2" then versions.pytorchWheels.rocm72
+    else versions.pytorchWheels.rocm71;
 
   # Pre-built PyTorch XPU wheels from pytorch.org (Intel oneAPI / SYCL)
   # Unlike CUDA/ROCm, the XPU torch wheel does NOT bundle its SYCL / MKL /
@@ -354,7 +359,10 @@ lib.optionalAttrs useCuda {
   };
 }
 # ROCm torch from pre-built wheels - avoids 30-60GB RAM compilation
-# The wheels bundle ROCm libraries internally, providing full GPU support
+# The wheels bundle ROCm libraries internally, providing full GPU support.
+# Defaults to ROCm 7.2 when available (fallback: 7.1).
+# For newer GPUs not in the official support matrix (e.g., Strix Halo / gfx1151),
+# set HSA_OVERRIDE_GFX_VERSION to force a compatible architecture.
 // lib.optionalAttrs useRocm {
   torch = final.buildPythonPackage {
     pname = "torch";
@@ -394,17 +402,18 @@ lib.optionalAttrs useCuda {
     doCheck = false;
 
     # Passthru attributes expected by downstream packages (xformers, bitsandbytes, etc.)
-    # The wheel bundles ROCm 7.1 and supports all GPU architectures
+    # The wheel bundles ROCm and supports all GPU architectures
     passthru = {
       cudaSupport = false;
       rocmSupport = true;
       # Provide rocmPackages for packages that need it (use default version)
       cudaPackages = { };
       rocmPackages = pkgs.rocmPackages;
+      inherit rocmVersion;
     };
 
     meta = {
-      description = "PyTorch with ROCm ${rocmWheels.torch.version} (pre-built wheel)";
+      description = "PyTorch with ROCm ${rocmVersion} (${rocmWheels.torch.version}, pre-built wheel)";
       homepage = "https://pytorch.org";
       license = lib.licenses.bsd3;
       platforms = [ "x86_64-linux" ];
