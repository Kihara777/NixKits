     cfg.dataDir
   ]
   ++ lib.optional cfg.enableManager "--enable-manager"
+  ++ lib.optional useRocm "--disable-xformers"  # nixpkgs xformers lacks ROCm backend
   ++ cfg.extraArgs;
   env = cfg.environment;
   escapedArgs = lib.concatStringsSep " " (map lib.escapeShellArg args);
@@ -111,6 +112,10 @@ in
         this configuration, `gfx1100` has been tested as working, but others
         may also work. Requires AMD drivers to be installed on the system.
 
+        For newer AMD GPUs not yet officially in the ROCm support matrix (e.g.
+        Strix Halo / gfx1151, RDNA 3.5 APUs), set `rocmGfxOverride` to force
+        a compatible GPU architecture (see below).
+
         ---
 
         Select `xpu` for Intel GPUs (oneAPI / SYCL, no IPEX required). Targets
@@ -132,6 +137,28 @@ in
       '';
     };
 
+    rocmGfxOverride = lib.mkOption {
+      type = lib.types.nullOr lib.types.str;
+      default = null;
+      example = "11.0.0";
+      description = ''
+        Override the GPU architecture version reported to the ROCm runtime via
+        the `HSA_OVERRIDE_GFX_VERSION` environment variable.
+
+        This is useful for newer AMD GPUs that are not yet in the ROCm support
+        matrix but are binary-compatible with an existing architecture.
+
+        Format: `major.minor.patch` (e.g., `"11.0.0"` for gfx1100).
+
+        Common values:
+        - `"11.0.0"`: gfx1100 (RDNA 3) — recommended for gfx1151 (Strix Halo / RDNA 3.5)
+        - `"11.5.1"`: gfx1151 native — may work if the ROCm runtime recognizes it
+        - `"10.3.0"`: gfx1030 (RDNA 2) — fallback for older RDNA cards
+
+        Only takes effect when `gpuSupport = "rocm"`.
+      '';
+    };
+
     cudaCapabilities = lib.mkOption {
       type = lib.types.nullOr (lib.types.listOf lib.types.str);
       default = null;
