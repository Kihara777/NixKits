{
  "name": "@kihara777/dsh-nixos-shell",
  "version": "0.1.0",
  "description": "Consolidated NixOS operations plugin for the DeepSeek Harness — NixOS-aware shell execution (PATH injection, nix shell tool bootstrap, external sudo daemon routing) plus read-only NixOS diagnostics (CLI capabilities, system status, generations, journal, store-path audit)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kihara777/NixKits.git",
    "directory": "packages/dsh-nixos-shell"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./nixos-gate": {
      "default": "./lib/nixos-gate.js"
    }
  },
  "bin": {
    "nixkits-sudo-exec": "./bin/nixkits-sudo-exec.js"
  },
  "files": [
    "lib/index.js",
    "lib/nixos-gate.js",
    "bin/nixkits-sudo-exec.js",
    "presets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-timer": "*"
  }
}
